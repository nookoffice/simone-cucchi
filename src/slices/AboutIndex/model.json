{
  "id": "about_index",
  "name": "AboutIndex",
  "type": "SharedSlice",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "About: a bio statement over an experience list",
      "docURL": "",
      "imageUrl": "",
      "version": "",
      "primary": {
        "intro": { "type": "StructuredText", "config": { "label": "Intro", "allowTargetBlank": false, "single": "paragraph" } },
        "experience": {
          "type": "Group",
          "config": {
            "label": "Experience",
            "fields": {
              "year": { "type": "Text", "config": { "label": "Year", "placeholder": "2026" } },
              "entry": { "type": "Text", "config": { "label": "Entry", "placeholder": "Client | Role" } }
            }
          }
        },
        "coordinates": {
          "type": "Text",
          "config": { "label": "Coordinates", "placeholder": "41.902782° N, 12.496366° E" }
        }
      }
    }
  ]
}
