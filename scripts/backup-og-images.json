        "primary": {
          "title": "Christie's App",
          "discipline": "Digital product design",
          "intro": [
            {
              "type": "paragraph",
              "text": "The Christie's App is one of the key destinations of Christie's top clients, who are highly engaged in the auction world. After re-launching a new simplified version of the App in 2021, it was necessary to build upon that, focusing on personalisation, new technology and brand. After analysing the data, we moved the overall app's focus, powering up the three most used areas: My Account, Search and Support. We created a brand new browse experience, combining auctions, private sales, stories and trends, all into one intuitive Explore section.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 152,
              "height": 85
